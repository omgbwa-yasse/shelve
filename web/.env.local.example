# Seul `src/lib/api/client.ts` a le droit de lire cette variable.
# Racine publique Laravel (SANS `/api`) : le proxy Next `/api/proxy/*` y ajoute
# le chemin complet (`/api/v1/...`, `/api/public/...`). Le navigateur n'appelle
# jamais cette URL directement.
NEXT_PUBLIC_API_BASE_URL=http://localhost/shelve/public
