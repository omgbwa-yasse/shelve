# OS
.DS_Store
Thumbs.db

# Environnement
.env
.env.local
.env.backup
.env.production
.env.testing

# Logs
*.log

# Fichiers temporaires (dumps SQL de travail, etc.)
laravel/tmp/

# Laravel (dans laravel/)
laravel/vendor/
laravel/node_modules/
laravel/public/build/
laravel/public/hot
laravel/public/storage
laravel/storage/*.key
laravel/bootstrap/cache/*.php
laravel/.phpunit.cache

# Backend Spring Boot (dans backend/)
backend/target/

# Frontend Next.js (dans web/)
web/node_modules/
web/.next/
web/out/
web/coverage/

# impeccable-ignore-start
# Output éphémère, état d'exécution et surcharges par développeur.
# Non ancré : .impeccable peut vivre à la racine du dépôt ou sous un workspace
# imbriqué (apps/web/.impeccable/...) ; des motifs ancrés le manqueraient.
# Les artefacts partagés restent versionnés : config.json, live/config.json,
# design.json, critique/*.md.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/*.png
.impeccable/live/server.json
.impeccable/live/sessions/
.impeccable/live/previews/
.impeccable/live/annotations/
.impeccable/live/cache/
.impeccable/live/manual-edit-apply-transaction.json
.impeccable/live/manual-edit-events.jsonl
.impeccable/live/manual-edit-evidence/
.impeccable/live/pending-manual-edits.json
.impeccable/live/deferred-svelte-component-accepts.json
.impeccable/live/*.png
# impeccable-ignore-end
